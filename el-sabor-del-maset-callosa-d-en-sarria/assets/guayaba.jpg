="nav-link d-lg-none p-1 mb-0 text-dark" aria-label="Cuenta" href="/acceso"><svg width="26" height="26" viewBox="0 0 24 24" stroke-width="2" stroke="black" fill="none" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path stroke="none" d="M0 0h24v24H0z"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/></svg></a></div><div class="collapse navbar-collapse order-3 order-lg-2" id="navbarResponsive"><ul class="navbar-nav ms-auto"><li class="nav-item"><a class="nav-link" href="/tienda">Tienda</a></li><li class="nav-item d-lg-none d-xl-block"><a class="nav-link" href="/sobre-nosotros">Quiénes somos</a></li><li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" id="accountDropdown" data-bs-toggle="dropdown" aria-expanded="false">Cuenta</a><ul class="dropdown-menu"><li><a class="dropdown-item" href="/acceso">Iniciar sesión</a></li><li><a class="dropdown-item" href="/alta-cliente">Alta cliente</a></li></ul></li></ul></div></div></nav></header><main role="main" class="container flex-grow-1"><div class="text-center mb-5"><h1>Página no encontrada 404</h1><p class="lead">Pues resulta que entre nuestros campos de cultivo de aguacates, mangos, caviar cítrico y otras frutas te has perdido.</p><p class="mb-4">No te preocupes, aquí tienes algunas opciones para encontrar tu camino:</p></div><div class="row justify-content-center"><div class="col-lg-3 col-md-6 mb-4"><div class="card h-100 shadow-sm border-0"><div class="card-body text-center d-flex flex-column"><div class="mb-3"><i class="fas fa-home fa-3x text-primary"></i></div><h5 class="card-title">Inicio</h5><p class="card-text flex-grow-1">Vuelve a nuestra página principal para descubrir todo lo que tenemos para ofrecerte.</p><a class="btn btn-success mt-auto" href="/">Ir al Inicio</a></div></div></div><div class="col-lg-3 col-md-6 mb-4"><div class="card h-100 shadow-sm border-0"><div class="card-body text-center d-flex flex-column"><div class="mb-3"><i class="fas fa-store fa-3x text-primary"></i></div><h5 class="card-title">Tienda</h5><p class="card-text flex-grow-1">Explora nuestros productos frescos: aguacates, mangos, caviar cítrico y más.</p><a class="btn btn-success mt-auto" href="/tienda">Ver Tienda</a></div></div></div><div class="col-lg-3 col-md-6 mb-4"><div class="card h-100 shadow-sm border-0"><div class="card-body text-center d-flex flex-column"><div class="mb-3"><i class="fas fa-users fa-3x text-primary"></i></div><h5 class="card-title">Quiénes Somos</h5><p class="card-text flex-grow-1">Conoce nuestra historia, valores y el equipo detrás de nuestros cultivos.</p><a class="btn btn-success mt-auto" href="/sobre-nosotros">Conócenos</a></div></div></div><div class="col-lg-3 col-md-6 mb-4"><div class="card h-100 shadow-sm border-0"><div class="card-body text-center d-flex flex-column"><div class="mb-3"><i class="fas fa-envelope fa-3x text-primary"></i></div><h5 class="card-title">Contacto</h5><p class="card-text flex-grow-1">¿Tienes alguna pregunta? Ponte en contacto con nosotros.</p><a class="btn btn-success mt-auto" href="/contacto">Contactar</a></div></div></div></div><div class="text-center mt-5"><p class="text-muted"><small>O utiliza el menú de navegación en la parte superior para encontrar lo que buscas.</small></p></div></main><div class="offcanvas offcanvas-end " tabindex="-1" id="offcanvasCistella" aria-labelledby="offcanvasCistellaLabel"><div class="offcanvas-header"><h5 id="offcanvasCistellaLabel">Resumen del pedido</h5><button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button></div><div class="offcanvas-body"></div></div><footer class="jsx-a94ad82f3bf9efb8 footer-modern"><div class="jsx-a94ad82f3bf9efb8 container"><div class="jsx-a94ad82f3bf9efb8 row gy-4 mb-4"><div class="jsx-a94ad82f3bf9efb8 col-md-4"><h3 class="jsx-a94ad82f3bf9efb8 footer-title">Contacta con nosotros:</h3><div class="jsx-a94ad82f3bf9efb8 contact-links"><a href="tel:003