<!-- WHATSAPP FLOTANTE: bebe del mismo grifo; sin WhatsApp válido, no se pinta.
     Y en la cesta, el pago y "mi cuenta" NO se pinta nunca: es un botón fijo
     y en el móvil caía encima de la esquina del botón de pagar (medido: tapaba
     56x36 px de "Realizar el pedido"), así que un dedo torcido se llevaba al
     comprador a WhatsApp con el pedido a medio pagar. -->
<a class="wa-float" href="https://wa.me/34614460898?text=Hola%2C%20me%20gustar%C3%ADa%20informarme%20sobre%20vuestras%20prendas%20de%20piel"
   target="_blank" rel="noopener" aria-label="WhatsApp">
  <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M16 .4C7.4.4.4 7.4.4 16c0 2.8.7 5.4 2 7.7L.3 31.6l8.1-2.1c2.2 1.2 4.8 1.9 7.6 1.9 8.6 0 15.6-7 15.6-15.6S24.6.4 16 .4zm0 28.5c-2.5 0-4.8-.7-6.8-1.8l-.5-.3-4.8 1.3 1.3-4.7-.3-.5c-1.3-2-2-4.4-2-6.9C2.9 8.8 8.8 2.9 16 2.9S29.1 8.8 29.1 16 23.2 28.9 16 28.9zm7.2-9.7c-.4-.2-2.3-1.1-2.7-1.3-.4-.1-.6-.2-.9.2-.3.4-1 1.3-1.2 1.5-.2.2-.4.3-.8.1-.4-.2-1.7-.6-3.2-2-1.2-1-2-2.4-2.2-2.8-.2-.4 0-.6.2-.8.2-.2.4-.4.6-.7.2-.2.3-.4.4-.7.1-.3 0-.5 0-.7-.1-.2-.9-2.1-1.2-2.9-.3-.8-.6-.7-.9-.7h-.7c-.3 0-.7.1-1 .5-.4.4-1.4 1.3-1.4 3.2s1.4 3.7 1.6 4c.2.2 2.7 4.2 6.6 5.9.9.4 1.6.6 2.2.8.9.3 1.7.2 2.4.1.7-.1 2.3-.9 2.6-1.8.3-.9.3-1.7.2-1.8-.1-.2-.3-.3-.7-.4z"/></svg>
</a>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  var hamburger = document.getElementById('hamburger');
  var mobileMenu = document.getElementById('mobileMenu');
  var mmClose = document.getElementById('mmClose');
  if (hamburger && mobileMenu && mmClose) {
    // La clase en <body> sirve para que el CSS esconda los botones flotantes
    // (WhatsApp y "Llamar") mientras el menú está abierto: tapaban entradas.
    var closeMenu = function(){
      hamburger.classList.remove('active');
      mobileMenu.classList.remove('open');
      document.body.classList.remove('gg-menu-abierto');
      // aria-expanded es lo que hace que un lector de pantalla diga
      // "contraído"/"expandido": sin esto el botón no cuenta si abre o cierra.
      hamburger.setAttribute('aria-expanded', 'false');
    };
    hamburger.addEventListener('click', function(){
      hamburger.classList.toggle('active');
      var abierto = mobileMenu.classList.toggle('open');
      document.body.classList.toggle('gg-menu-abierto', abierto);
      hamburger.setAttribute('aria-expanded', abierto ? 'true' : 'false');
    });
    mmClose.addEventListener('click', closeMenu);
    Array.prototype.forEach.call(mobileMenu.querySelectorAll('a'), function(a){
      a.addEventListener('click', closeMenu);
    });
    // Escape cierra el menú y devuelve el foco a la hamburguesa. Va en SU
    // propio manejador: el otro Escape de esta página vive dentro del "if" del
    // buscador y, si algún día no se pinta la lupa, se llevaría este por delante.
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
        closeMenu();
        hamburger.focus();
      }
    });
  }

  // Buscador de la cabecera: la lupa despliega la barra. Sin JavaScript la
  // barra no se abre, pero el buscador del listado y el del menú móvil son
  // formularios normales y siguen funcionando.
  var bBtn = document.getElementById('ggBuscarBtn');
  var bBar = document.getElementById('ggBuscador');
  if (bBtn && bBar) {
    bBtn.addEventListener('click', function(){
      var abierto = bBar.hasAttribute('hidden');
      if (abierto) { bBar.removeAttribute('hidden'); } else { bBar.setAttribute('hidden',''); }
      bBtn.setAttribute('aria-expanded', abierto ? 'true' : 'false');
      if (abierto) { var i = bBar.querySelector('input[type=search]'); if (i) { i.focus(); } }
    });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && !bBar.hasAttribute('hidden')) {
        bBar.setAttribute('hidden',''); bBtn.setAttribute('aria-expanded','false'); bBtn.focus();
      }
    });
  }

  // En móvil la fila de secciones rueda de lado: se acerca la que estás
  // viendo para que no quede escondida a la derecha.
  var chips = document.querySelector('.gg-chips');
  if (chips) {
    var activa = chips.querySelector('.gg-chip-on');
    if (activa && chips.scrollWidth > chips.clientWidth) {
      chips.scrollLeft = Math.max(0, activa.offsetLeft - (chips.clientWidth - activa.offsetWidth) / 2);
    }
  }

  // Mientras el bloque de compra de la ficha está a la vista, los botones
  // flotantes se apartan. Sin esto se pintan ENCIMA del botón de comprar (el
  // de "Llamar" tapaba la esquina de abajo a la izquierda de AÑADIR AL CARRITO)
  // y el dedo se iba a hacer una llamada en vez de a la cesta. Solo se esconde
  // un enlace: no se toca ni un campo del formulario de compra.
  var ggCompra = document.querySelector('.single-product form.cart, .single-product .single_add_to_cart_button');
  if (ggCompra && 'IntersectionObserver' in window) {
    var ioCompra = new IntersectionObserver(function(entradas){
      entradas.forEach(function(e){
        document.body.classList.toggle('gg-compra-a-la-vista', e.isIntersecting);
      });
    }, { threshold: 0 });
    ioCompra.observe(ggCompra);
  } else if (ggCompra) {
    // Navegador sin IntersectionObserver: mejor sin flotantes en la ficha que
    // con un flotante encima del botón de comprar. Y queda dicho por qué.
    document.body.classList.add('gg-compra-a-la-vista');
    if (window.console) { console.warn('gg-farre: sin IntersectionObserver — los botones flotantes se ocultan en la ficha para no tapar el botón de comprar.'); }
  }

  var faders = document.querySelectorAll('.fade-in');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    faders.forEach(function(el){ io.observe(el); });
  } else {
    faders.forEach(function(el){ el.classList.add('visible'); });
  }
</script>
